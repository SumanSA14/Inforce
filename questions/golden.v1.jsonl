{"qid": "sec-nbfc-01", "text": "What minimum retention requirement applies to an NBFC securitising loans with maturity over 24 months?", "topic": "securitisation", "category": "Non-Banking Financial Companies", "answerable": true, "expected_doc_key": "md:4f3639bb1c5c2e55", "expected_quote": "(2) For underlying loans with original maturity of more than 24 months as well as loans with bullet repayments, as mentioned in proviso to Paragraph 5, the MRR shall be 10 per cent of the book value of the loans being securitised.", "trap_doc_keys": ["notif:9913", "notif:9078", "notif:11422"], "difficulty": "medium", "notes": "traps observed from naive retrieval; quote auto-extracted"}
{"qid": "sec-nbfc-02", "text": "How much of a residential mortgage pool must the originator keep on its own books?", "topic": "securitisation", "category": "Non-Banking Financial Companies", "answerable": true, "expected_doc_key": "md:4f3639bb1c5c2e55", "expected_quote": "In the case of residential mortgage backed securities, the MRR for the originator shall be 5 per cent of the book value of the loans being securitised, irrespective of the original maturity.", "trap_doc_keys": ["notif:12165"], "difficulty": "medium", "notes": "traps observed from naive retrieval; quote auto-extracted"}
{"qid": "sec-nbfc-03", "text": "Can an originator hold unlimited exposure to a single securitisation deal?", "topic": "securitisation", "category": "Non-Banking Financial Companies", "answerable": true, "expected_doc_key": "md:4f3639bb1c5c2e55", "expected_quote": "The total exposure of an originator to the securitisation exposures belonging to a particular securitisation structure or scheme should not exceed 20 per cent of the total securitisation exposures created by such structure or scheme.", "trap_doc_keys": ["notif:12165"], "difficulty": "hard", "notes": "traps observed from naive retrieval; quote auto-extracted"}
